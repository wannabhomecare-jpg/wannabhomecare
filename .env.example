# 이름과 용도만 적는다. 값은 .env.local 에만 넣는다(이 파일에 값을 넣지 않는다).

# ---------- 작업용(.env.local 에만. Vercel·GitHub 에 올리지 않는다) ----------
# Vercel API·CLI 토큰
VERCEL_TOKEN=
# Vercel 범위(Hobby 팀) ID
VERCEL_TEAM_ID=
# Vercel 프로젝트 wannabhomecare 의 ID
VERCEL_PROJECT_ID=
# Supabase Management API·CLI 토큰
SUPABASE_ACCESS_TOKEN=
# Supabase 조직 ID
SUPABASE_ORG_ID=
# Supabase 프로젝트 wannabhomecare 의 ref
SUPABASE_PROJECT_REF=
# 무작위로 만든 DB 비밀번호
SUPABASE_DB_PASSWORD=
# (선택) 기반 저장소 주소 — scripts/check-access.mjs 의 읽기 확인용
BASE_REPO_URL=

# ---------- 사이트(공개 값. Vercel 환경변수에 등록) ----------
# 사이트 주소(끝에 / 없이)
NEXT_PUBLIC_SITE_URL=
# 사이트 이름
NEXT_PUBLIC_SITE_NAME=
# 단계: preview(미리보기, 검색 차단·예시 표시) | production(오픈)
NEXT_PUBLIC_SITE_STAGE=
# 대표번호(숫자만 또는 010-0000-0000)
NEXT_PUBLIC_PHONE=
# 카카오톡 채널 주소(https://pf.kakao.com/...). 비어 있으면 미리보기에서는 '연결 전' 안내
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 검색 등록 소유 확인 값(Phase 6). 비어 있으면 메타 태그를 넣지 않는다
NEXT_PUBLIC_NAVER_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ---------- Supabase(공개 키) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- 서버 전용(Vercel 에 Sensitive 로만) ----------
# Supabase 서버 키(service_role)
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 비밀번호(무작위)
ADMIN_PASSWORD=
# 관리자 세션 서명 값(무작위 32자 이상)
SESSION_SECRET=
