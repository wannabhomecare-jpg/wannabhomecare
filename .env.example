# 이름과 용도만 적는다. 값은 .env.local 에만 넣는다.
# 앱에서 쓰는 이름은 Phase 1 에서 덧붙인다.

# Vercel API·CLI (사용자가 넣는다)
VERCEL_TOKEN=
# 프로젝트를 만들 Vercel 범위(Hobby 팀) (Phase 0)
VERCEL_TEAM_ID=
# wannab-homecare 프로젝트 (Phase 1)
VERCEL_PROJECT_ID=

# Supabase Management API·CLI (사용자가 넣는다)
SUPABASE_ACCESS_TOKEN=
# 프로젝트를 만들 Supabase 조직 (Phase 0)
SUPABASE_ORG_ID=
# wannab-homecare 프로젝트 (Phase 1)
SUPABASE_PROJECT_REF=
# 무작위로 만든 DB 비밀번호 (Phase 1)
SUPABASE_DB_PASSWORD=
